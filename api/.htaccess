# Headers CORS complets

<IfModule mod_headers.c>
    # Autoriser localhost + domaines de production (avec et sans www)
    SetEnvIf Origin "^https?://(www\.)?rababali\.com$" AccessControlAllowOrigin=$0
    SetEnvIf Origin "^http://localhost:5173$" AccessControlAllowOrigin=$0
    Header always set Access-Control-Allow-Origin %{AccessControlAllowOrigin}e env=AccessControlAllowOrigin
    
    # Méthodes autorisées
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    
    # Headers autorisés (inclut Cache-Control)
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cache-Control"
    
    # Credentials et cache
    Header always set Access-Control-Allow-Credentials "false"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Gestion des requêtes OPTIONS (preflight)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
